{
  "hooksConfig": {
    "disabled": [
      "single-edit-per-turn-reset",
      "command-fixer-hook"
    ]
  },
  "mcpServers": {
    "lsp-python": {
      "command": "npx",
      "args": [
        "-y",
        "tritlo/lsp-mcp",
        "python",
        "./node_modules/.bin/pyright-langserver",
        "--stdio"
      ]
    },
    "lsp-typescript": {
      "command": "npx",
      "args": [
        "-y",
        "tritlo/lsp-mcp",
        "typescript",
        "./node_modules/.bin/typescript-language-server",
        "--stdio"
      ]
    }
  }
}
